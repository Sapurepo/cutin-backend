NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://cutin:cutin@localhost:5432/cutin
# openssl rand -hex 32 등으로 생성 (32자 이상)
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Google OAuth 클라이언트 ID — id_token의 audience 검증에 사용
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# 서버 자신의 공개 주소 (업로드 목적지 · 포스트 공유 링크)
# 배포 시: https://api-stg.getcutin.app · https://api.getcutin.app
PUBLIC_BASE_URL=http://localhost:3000
# 클라이언트에 내려줄 미디어 URL의 앞부분. 미설정 시 PUBLIC_BASE_URL을 쓴다
# 배포 시: https://cdn-stg.getcutin.app · https://cdn.getcutin.app
# MEDIA_BASE_URL=
# 로컬 디스크 스토리지 경로 (스토리지 벤더 확정 시 제거)
STORAGE_DIR=./storage
# APNs — 넷을 모두 채우면 실제로 발송하고, 모두 비우면 로그만 남긴다.
# 일부만 채우면 부팅이 실패한다 ("설정했는데 푸시가 안 온다"를 막기 위해서다).
# 값은 Apple Developer > Keys에서 받는다. 자세한 절차는 docs/appleAccount.md
# APNS_KEY_ID=ABCD123456
# APNS_TEAM_ID=1234567890
# .p8 파일 내용. 한 줄로 넣을 때는 개행을 \n으로 이스케이프한다
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
# 빌드 configuration마다 다르다 (docs/clientEnvironments.md §2)
# APNS_BUNDLE_ID=app.getcutin.ios
