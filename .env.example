NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://cutin:cutin@localhost:5432/cutin
# openssl rand -hex 32 등으로 생성 (32자 이상)
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Google OAuth 클라이언트 ID — id_token의 audience 검증에 사용
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# 클라이언트에 내려줄 미디어 URL의 앞부분
PUBLIC_BASE_URL=http://localhost:3000
# 로컬 디스크 스토리지 경로 (스토리지 벤더 확정 시 제거)
STORAGE_DIR=./storage
