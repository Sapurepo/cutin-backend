{
  "name": "cutin-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import @swc-node/register/esm-register src/db/migrate.ts",
    "db:seed": "node --import @swc-node/register/esm-register src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "node --import @swc-node/register/esm-register scripts/exportOpenapi.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "jose": "^6.2.8",
    "nestjs-zod": "^5.5.0",
    "pg-boss": "^12.27.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@nestjs/testing": "^11.1.29",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
